# .env.worker.example
#
# Environment for the standalone worker compose
# (docker/docker-compose.worker.yml). Copy to .env.worker (gitignored) and
# fill in your values.
#
#     cp .env.worker.example .env.worker
#
# This file is NOT picked up automatically — Compose only auto-loads `.env`.
# It must be named on the command line, every time:
#
#     docker compose --env-file .env.worker -f docker-compose.worker.yml up -d
#
# Used only by the static-operator workflow. If you run Ansible
# (ansible/playbooks/distribute-worker.yml) the worker role renders its own
# compose with values taken from inventory/group_vars, and nothing on the
# worker host reads this file.

# Compose project for the worker stack. Keep it distinct from the Core stack's
# COMPOSE_PROJECT_NAME (taranis-ng in docker/.env): both compose files define a
# service called `traefik`, so sharing a project name would make `up` recreate
# Core's Traefik from this file and treat the rest of Core as orphans.
COMPOSE_PROJECT_NAME=taranis-ng-worker

# Worker type — one of: collectors, bots, presenters, publishers
WORKER_TYPE=collectors

# Taranis-NG image tag (mirrors docker/.env TARANIS_NG_TAG)
TARANIS_NG_TAG=latest

# Core's HTTPS URL, reachable from this worker host
CORE_URL=https://taranis-core.example.com

# Public hostname of THIS worker, as Core will address it (must match the
# Traefik Host rule and the TLS cert CN)
WORKER_HOST=worker-collectors-01.example.com

# Timezone
TZ=Europe/Bratislava

# Log levels
TARANIS_LOG_LEVEL=INFO
MODULES_LOG_LEVEL=INFO

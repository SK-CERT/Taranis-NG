# General
COMPOSE_PROJECT_NAME=taranis-ng
HTTP_PROXY=
HTTPS_PROXY=

# Versions
TARANIS_NG_TAG=26.05.1

# Timezone for all containers
TZ=Europe/Bratislava

# Force language
VUE_APP_TARANIS_NG_LOCALE=""

# Paths
CVE_UPDATE_FILE=/data/cve_dictionary.xml
CPE_UPDATE_FILE=/data/cpe_dictionary.xml
CWE_UPDATE_FILE=/data/cwe_dictionary.xml

# Web host and ports
TARANIS_NG_HOSTNAME=localhost
TARANIS_NG_HTTPS_PORT=4443
TARANIS_NG_HTTP_PORT=8080
TARANIS_NG_HTTPS_URI=https://localhost:4443
TARANIS_NG_AUTHENTICATOR=password

# To use LDAP authentication, adjust the following lines to your LDAP server,
# change TARANIS_NG_AUTHENTICATOR to ldap and add CA certificate to "auth/ldap_ca.pem"
# or point LDAP_CA_CERT_PATH to it.
LDAP_SERVER=ldaps://ldap.example.com
LDAP_BASE_DN="ou=people,dc=example,dc=com"

# Public-web report feed. Empty (COMPOSE_PROFILES=) disables it entirely.
COMPOSE_PROFILES=public-web

# ACME resolver to put on every router (main hostname + each public web). Must
# name one defined in acme.env; unset means the self-signed default certificate.
# Overridable per web in the GUI.
# TRAEFIK_CERT_RESOLVER=myresolver

# The resolvers themselves are defined in acme.env - copy acme.env.example to
# acme.env and uncomment the block for your CA (Let's Encrypt, ZeroSSL or your own).
# Several may coexist; this variable picks the default.

# HSTS is a Traefik middleware, set in the GUI (Application Settings -> Routing &
# TLS). Ships off - turn it on only once certificates are being issued.

# Unauthenticated dashboard/API: keep the 127.0.0.1 prefix or it is published on
# every host interface.
TRAEFIK_MANAGEMENT_PORT=127.0.0.1:8081

# Satellite API port - DISTRIBUTED DEPLOYMENTS ONLY.
#
# Remote collectors, bots and public-web nodes call core on this port instead of
# 443, so it can be firewalled to the worker hosts while 443 stays open to the
# world for the GUI and the public webs. It also serves the per-node Traefik
# provider a remote node polls for its own routers.
#
# A single-host install never uses it: those satellites reach core at http://core
# over the compose network. Hence the loopback binds below - change them to
# 0.0.0.0 and :: only when you have remote workers, and firewall the port to them.
#
# Both, not just the first: naming a host address pins the mapping to that address
# family, so setting only _BIND leaves the port unreachable for any worker that
# resolves this host's AAAA record - and unreachable as a TIMEOUT, not a refusal,
# because nothing published on v6 means the packets fall through to filter/INPUT
# where a default-deny host firewall drops them. Set both or neither.
TARANIS_NG_SATELLITE_BIND=127.0.0.1
TARANIS_NG_SATELLITE_BIND6=::1
TARANIS_NG_SATELLITE_PORT=8443

# Limits
DB_SHARED_BUFFERS=64MB
DB_MAX_CONNECTIONS=1000

# Ports
PRESENTER_PORT=5002

# Jinja templates path
JINJA_TEMPLATES_ROOT="/app/templates"

# Standalone Keycloak
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=supersecret
POSTGRES_KEYCLOAK_PASSWORD=supersecret

# Logging of Taranis-NG and used Python modules
TARANIS_LOG_LEVEL=DEBUG
MODULES_LOG_LEVEL=WARN
# To change Traefik logging, set TRAEFIK_LOG_LEVEL here (default WARN)
# To change Nginx log level, go to docker-compose.yml and change NGINX_LOG_LEVEL and NGINX_ACCESS_LOG there
# To change Redis log level, go to docker-compose.yml and change --loglevel there


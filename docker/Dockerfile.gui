# build stage
FROM node:lts-alpine AS build-stage

WORKDIR /app
COPY ./src/gui/package*.json ./
COPY ./src/gui/scripts ./scripts
COPY ./src/gui/eslint.config.js .
COPY ./src/gui/vite.config.js .
COPY ./.git ./.git
COPY ./VERSION.md .
RUN apk add --no-cache git
RUN npm install
COPY ./src/gui/index.html .
COPY ./src/gui/public /app/public
COPY ./src/gui/src /app/src

RUN npm run build

# production stage
FROM nginx:stable-alpine AS production-stage

RUN rm /docker-entrypoint.d/30-tune-worker-processes.sh
COPY ./src/gui/extras/30-envsubst-on-javascript.sh /docker-entrypoint.d/
COPY ./src/gui/extras/40-connection-tuning.sh /docker-entrypoint.d/
COPY ./src/gui/extras/50-logging.sh /docker-entrypoint.d/
RUN chmod +x /docker-entrypoint.d/*.sh

COPY ./src/gui/extras/default.conf /etc/nginx/conf.d/default.conf
# Included by default.conf at server level and inside the two location blocks that
# declare their own add_header - nginx would otherwise drop the security headers there.
COPY ./src/gui/extras/security-headers.inc /etc/nginx/conf.d/security-headers.inc

COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY ./VERSION.md /usr/share/nginx/html/VERSION.txt

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

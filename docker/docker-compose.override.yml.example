# Local, per-deployment tweaks. Copy to docker-compose.override.yml (gitignored);
# compose loads it automatically when run from this directory.

services:
  gui:
    environment:
      # Example: prefer GET for deployments whose auth endpoints reject POST.
      VITE_APP_TARANIS_NG_LOGIN_METHOD: "get"
      VITE_APP_TARANIS_NG_LOGOUT_METHOD: "get"
      VITE_APP_TARANIS_NG_SSE_INIT_METHOD: "get"

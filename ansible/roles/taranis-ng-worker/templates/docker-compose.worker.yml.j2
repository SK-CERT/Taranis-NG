# Taranis-NG worker compose — rendered by Ansible onto the remote worker host.
# This file is generated from templates/docker-compose.worker.yml.j2 and must
# NOT be edited directly on the worker — changes will be overwritten on the
# next ansible-playbook run.
#
# One Traefik fronts ALL worker_types on this host. Each worker_type service
# has its own Traefik router keyed on the per-type subdomain
# (<type>.<worker_base_hostname>), so Core reaches each worker_type at
# https://<type>.<worker_base_hostname>:{{ worker_api_port }}/.
#
# Two exposure classes, two entrypoints. The worker API answers on
# `api` ({{ worker_api_port }}), which a firewall restricts to the Core host;
# public-web's own webs answer on `websecure` (443), which must stay open to the
# world. They cannot share a port: Host-header routing is invisible to a packet
# filter, so one port carrying both admits everybody or nobody.
#
# This is a per-host compose; it is separate from the all-in-one
# docker/docker-compose.yml used on the Core host.
#
# Traefik takes its static configuration from EXACTLY ONE source, and a mounted
# /etc/traefik/traefik.yml silently beats CLI flags. ACME mode therefore ships
# the static file and no `command:`; the other modes ship `command:` and no
# static file. Never both.

services:
  traefik:
    image: docker.io/traefik:{{ worker_traefik_version }}
    restart: unless-stopped
{% if worker_tls_mode == "acme" %}
    # ACME mode: the whole static config lives in /etc/traefik/traefik.yml
    # (rendered from traefik.yml.j2), so no `command:` here.
{% else %}
    # {{ worker_tls_mode | capitalize }} mode: TLS terminated with our own cert,
    # which the file provider picks up from /etc/traefik/dynamic/certs.yml.
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--providers.file.watch=true"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.api.address=:{{ worker_api_port }}"
      - "--entrypoints.web.http.redirections.entrypoint.to=websecure"
      - "--entrypoints.web.http.redirections.entrypoint.scheme=https"
      - "--entrypoints.websecure.http.tls=true"
      - "--entrypoints.api.http.tls=true"
{% if "public-web" in worker_types %}
      # This host's public webs, their certificates and the security-headers
      # middleware, scoped to THIS node and authenticated with its own api_key.
      - "--providers.http.endpoint={{ core_satellite_url }}/traefik/dynamic/node"
      - "--providers.http.pollinterval=10s"
      - "--providers.http.headers.Authorization=ApiKey {{ worker_effective_api_keys['public-web'] }}"
{% endif %}
{% endif %}
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
      # The API Core calls. Published with NO host address when it should listen
      # everywhere, exactly like 80 and 443 above, because naming one pins the mapping
      # to that address FAMILY: "0.0.0.0:8443:8443" is IPv4 only, leaving every
      # hostname with an AAAA record unreachable here - as a timeout, not a refusal,
      # which reads like a routing fault. Naming a real address is single-family too,
      # which is the point of worker_api_bind: one address on one interface.
{% if worker_api_bind in ["0.0.0.0", "::", ""] %}
      - "{{ worker_api_port }}:{{ worker_api_port }}"
{% else %}
      - "{{ worker_api_bind }}:{{ worker_api_port }}:{{ worker_api_port }}"
{% endif %}
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
{% if worker_tls_mode == "acme" %}
      - "{{ worker_tls_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro"
{% endif %}
      # The dynamic/ SUBDIRECTORY only — mounting {{ worker_tls_dir }} itself
      # would feed traefik.yml back in as a dynamic document.
      - "{{ worker_tls_dir }}/dynamic:/etc/traefik/dynamic:ro{{ worker_selinux_mount_suffix }}"
{% if worker_tls_mode != "acme" %}
      - "{{ worker_tls_dir }}/certs:/etc/traefik/certs:ro{{ worker_selinux_mount_suffix }}"
{% else %}
      - "acme_storage:/letsencrypt"
{% endif %}
{% if worker_tls_mode == "acme" and worker_acme_challenge == "dns" and worker_acme_dns_env | length > 0 %}
    environment:
{% for k, v in worker_acme_dns_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
{% endif %}
    networks:
      - worker_net

{% for worker_type in worker_types %}
  {{ worker_type }}:
    image: "{{ worker_image_prefix }}{{ worker_type }}:{{ taranis_ng_tag }}"
    restart: unless-stopped
    environment:
      TARANIS_NG_CORE_URL: "{{ core_satellite_url }}"
{% if worker_type == "bots" %}
      TARANIS_NG_CORE_SSE: "{{ core_sse_url }}"
{% endif %}
      TZ: "{{ worker_tz }}"
      TARANIS_LOG_LEVEL: "{{ taranis_log_level }}"
      MODULES_LOG_LEVEL: "{{ modules_log_level }}"
{% if worker_type == "presenters" %}
      JINJA_TEMPLATES_ROOT: "{{ jinja_templates_root }}"
{% endif %}
{% if worker_type == "collectors" %}
      COLLECTOR_CONFIG_FILE: "/app/storage/id.txt"
{% endif %}
{% if worker_type == "collectors" %}
    volumes:
      - "{{ worker_type }}_storage:/app/storage"
{% elif worker_type == "presenters" %}
    volumes:
      - "{{ worker_type }}_storage:/app/templates/user_templates"
{% endif %}
    # `target: api_key` is load-bearing: every worker reads the key from
    # /run/secrets/api_key (see src/<type>/config.py read_secret("api_key")).
    secrets:
      - source: api_key_{{ worker_type }}
        target: api_key
    labels:
      - "traefik.enable=true"
      # The API Core calls, on the restricted entrypoint. Same subdomain as
      # before, different port - it is what this node's api_url points at.
      - "traefik.http.routers.{{ worker_type }}.rule=Host(`{{ worker_type }}.{{ worker_base_hostname }}`)"
      - "traefik.http.routers.{{ worker_type }}.entrypoints=api"
{% if worker_tls_mode == "acme" %}
      - "traefik.http.routers.{{ worker_type }}.tls.certresolver={{ worker_acme_resolver_name }}"
{% else %}
      - "traefik.http.routers.{{ worker_type }}.tls=true"
{% endif %}
      - "traefik.http.services.{{ worker_type }}.loadbalancer.server.port=80"
{% if worker_type == "public-web" %}
      # The public side. Every configured web gets its own Host() router from
      # core's provider; this is the catch-all beneath them, at the lowest
      # priority, so an unconfigured hostname still reaches the app and gets a
      # clean 404 instead of a Traefik error page.
      - "traefik.http.routers.{{ worker_type }}-public.rule=PathPrefix(`/`)"
      - "traefik.http.routers.{{ worker_type }}-public.entrypoints=websecure"
      - "traefik.http.routers.{{ worker_type }}-public.priority=1"
      - "traefik.http.routers.{{ worker_type }}-public.tls=true"
      # @file, not @http: the fallback has to keep working when core is
      # unreachable, which is exactly when the node is serving from its cache.
      - "traefik.http.routers.{{ worker_type }}-public.middlewares=public-web-security-headers@file"
      - "traefik.http.routers.{{ worker_type }}-public.service={{ worker_type }}"
{% endif %}
    networks:
      - worker_net
    logging:
      driver: "json-file"
      options:
        max-size: "200k"
        max-file: "10"

{% endfor %}
secrets:
{% for worker_type in worker_types %}
  api_key_{{ worker_type }}:
    file: "{{ worker_secrets_dir }}/api_key.{{ worker_type }}.txt"
{% endfor %}

{# A bare `volumes:` key with no children is invalid compose. #}
{% set named_volumes = worker_types | select('in', ['collectors', 'presenters']) | list %}
{% if named_volumes | length > 0 or worker_tls_mode == "acme" %}
volumes:
{% for worker_type in named_volumes %}
  {{ worker_type }}_storage:
{% endfor %}
{% if worker_tls_mode == "acme" %}
  acme_storage:
{% endif %}
{% endif %}

networks:
  worker_net:
    driver: bridge

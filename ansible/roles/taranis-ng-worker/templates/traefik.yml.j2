# Worker Traefik static configuration — generated by Ansible when
# worker_tls_mode == "acme". Edit the role defaults/group_vars, not this file
# on the worker host — subsequent Ansible runs will overwrite it.

entryPoints:
  web:
    address: ":80"
{% if worker_acme_challenge != "http" %}
    # Redirect http → https. Skipped for HTTP-01 challenges: Traefik needs
    # :80 free to answer the ACME challenge, and a permanent redirect on
    # /.well-known/acme-challenge/* would break issuance. (Traefik does
    # intercept ACME before redirects in practice, but keeping :80 free
    # makes intent explicit and avoids surprises with custom ACME servers.)
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
{% endif %}
  websecure:
    address: ":443"
    http3: {}
  # The worker API, kept off 443 so a firewall can admit only the Core host
  # while 443 stays world-open for public-web's own hostnames. ACME is
  # unaffected: challenges are answered on :80 (HTTP-01) or :443 (TLS-ALPN-01)
  # whichever entrypoint ends up serving the router, so :80 must stay reachable.
  api:
    address: ":{{ worker_api_port }}"
  traefik:
    address: ":9090"

api:
  insecure: true
  dashboard: true

log:
  level: "{{ worker_traefik_log_level | default('WARN') }}"

providers:
  docker:
    exposedByDefault: false
  file:
    directory: /etc/traefik/dynamic
    watch: true
{% if "public-web" in worker_types %}
  # This host's public webs: a router per hostname, their certificates and the
  # security-headers middleware, served by core. Scoped to THIS node and
  # authenticated with its own api_key - the unscoped /traefik/dynamic carries
  # every node's webs and the private keys inlined beside them, and is not
  # published.
  http:
    endpoint: "{{ core_satellite_url }}/traefik/dynamic/node"
    pollInterval: "10s"
    headers:
      Authorization: "ApiKey {{ worker_effective_api_keys['public-web'] }}"
{% endif %}

certificatesResolvers:
  {{ worker_acme_resolver_name }}:
    acme:
      email: "{{ worker_acme_email }}"
      storage: /letsencrypt/acme.json
      caServer: "{{ worker_acme_caserver }}"
      keyType: {{ worker_acme_keytype }}
{% if worker_acme_eab_kid | length > 0 and worker_acme_eab_hmac | length > 0 %}
      eab:
        kid: "{{ worker_acme_eab_kid }}"
        hmacEncoded: "{{ worker_acme_eab_hmac }}"
{% endif %}
{% if worker_acme_challenge == "http" %}
      httpChallenge:
        entryPoint: web
{% elif worker_acme_challenge == "tlsalpn" %}
      tlsChallenge:
{% elif worker_acme_challenge == "dns" %}
      dnsChallenge:
        provider: "{{ worker_acme_dns_provider }}"
{% endif %}

accessLog: {}

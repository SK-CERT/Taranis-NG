# Worker Traefik DYNAMIC configuration — generated by Ansible when
# worker_tls_mode is "selfsigned" or "provided". Edit the role defaults or your
# group_vars/host_vars, not this file on the worker host — subsequent Ansible
# runs overwrite it.
#
# Paths below are the container-side mount of {{ worker_tls_certs_dir }}.

tls:
  stores:
    default:
      defaultCertificate:
        certFile: /etc/traefik/certs/worker.crt
        keyFile: /etc/traefik/certs/worker.key
  certificates:
    - certFile: /etc/traefik/certs/worker.crt
      keyFile: /etc/traefik/certs/worker.key

# Worker Traefik TLS policy — generated by Ansible. Edit the role defaults or
# your group_vars/host_vars, not this file on the worker host; subsequent runs
# overwrite it.
#
# Mirrors the Core stack's TLS options, which core serves to Traefik from
# Configuration -> Application Settings -> Routing & TLS, so both ends
# of the Core<->worker link enforce the same policy.
#
# tls.options is DYNAMIC configuration, which is why this lives in
# {{ worker_tls_dynamic_dir }} rather than the ACME static traefik.yml.
#
# `default` applies to every router that does not name its own options — which
# is all of them here. Traefik allows exactly one provider to define `default`;
# this file provider is the only one on a worker host, so there is no conflict.

tls:
  options:
    default:
      # VersionTLS13 is what removes the obsolete CBC suites (AES-CBC, ARIA,
      # 3DES ...): TLS 1.3 defines none of them, so the cipherSuites list below
      # becomes irrelevant. Lower this to VersionTLS12 only for a client that
      # genuinely cannot do 1.3 — the list then takes effect and still excludes
      # CBC. Go, and therefore Traefik, does not allow configuring the TLS 1.3
      # suites at all.
      minVersion: {{ worker_tls_min_version }}

      # Only consulted when minVersion is VersionTLS12. AEAD suites only:
      # GCM and ChaCha20-Poly1305, no CBC, no SHA-1.
      cipherSuites:
{% for suite in worker_tls_cipher_suites %}
        - {{ suite }}
{% endfor %}

      curvePreferences:
{% for curve in worker_tls_curve_preferences %}
        - {{ curve }}
{% endfor %}

{
    "name": "taranis-ng-gui-v3",
    "version": "26.05.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:remote": "vite --host 127.0.0.1 --port 4444 --strictPort",
        "prebuild": "node scripts/update-version.cjs",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,json}\" \"src/**/*.d.ts\" \"tests/**/*.{js,ts}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,scss,json}\" \"src/**/*.d.ts\" \"tests/**/*.{js,ts}\"",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "pretypecheck": "node scripts/update-version.cjs",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "test": "vitest",
        "test:unit": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui --config=playwright.ui.config.js",
        "test:e2e:ui:remote": "playwright test --ui --ui-host=127.0.0.1 --ui-port=9323 --config=playwright.ui.config.js",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@primeuix/themes": "^3.0.0",
        "@types/d3-cloud": "^1.2.9",
        "@simplewebauthn/browser": "^13.3.0",
        "ae-cvss-calculator": "^1.0.13",
        "axios": "^1.19.0",
        "d3-cloud": "^1.2.9",
        "date-fns": "^4.4.0",
        "dompurify": "^3.4.13",
        "pinia": "^4.0.3",
        "primeicons": "^8.0.0",
        "primevue": "5.0.1",
        "qrcode": "^1.5.4",
        "quill": "^2.0.3",
        "vee-validate": "^4.14.11",
        "vue": "^3.5.41",
        "vue-i18n": "^11.4.8",
        "vue-router": "^5.2.0",
        "vuetify": "^4.1.9"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
        "@playwright/test": "^1.61.1",
        "@types/node": "^26.1.2",
        "@types/qrcode": "^1.5.6",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "happy-dom": "^20.11.2",
        "jsdom": "^30.0.1",
        "jsonc-eslint-parser": "^3.3.0",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "sass": "^1.101.0",
        "typescript": "^6.0.3",
        "vite": "^8.1.3",
        "vite-plugin-vuetify": "^2.1.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.d.ts": [
            "prettier --write"
        ],
        "*.{css,scss,json,md}": [
            "prettier --write"
        ],
        "src/i18n/*.json": [
            "eslint"
        ]
    }
}
